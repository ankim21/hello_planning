// Data model for brick 1. See docs/architecture.md, section 5.
// All timestamps are stored in UTC; each site carries its timezone.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Organisation ─────────────

model LegalEntity {
  id        String     @id @default(uuid())
  name      String     @unique
  sites     Site[]
  contracts Contract[]
}

enum SiteType {
  RESTAURANT
  LAB
  OFFICE
}

model Site {
  id            String           @id @default(uuid())
  name          String           @unique
  type          SiteType
  timezone      String           @default("Europe/Paris")
  legalEntityId String
  legalEntity   LegalEntity      @relation(fields: [legalEntityId], references: [id])
  assignments   SiteAssignment[]
  roleGrants    RoleGrant[]
  devices       Device[]
  shifts        Shift[]
  clockEvents   ClockEvent[]
  dayLocks      DayLock[]
  timeEntries   TimeEntry[]
  leaveRequests LeaveRequest[]
  publications  Publication[]
  staffingNeeds StaffingNeed[]
  posts         SitePost[]
  archiveRequests ArchiveRequest[]
}

enum Department {
  KITCHEN
  SALLE
}

// A post is a station (Pass, Runner…). It is stored once; AM / PM is chosen on
// the shift, so every post automatically exists for both services.
model Post {
  id         String         @id @default(uuid())
  name       String         @unique
  department Department
  color      String         @default("#9ca3af") // card colour on the planning
  // The person on this post runs the service: staff call them when they
  // cannot come at the last minute. True for "Manager".
  isServiceLead Boolean     @default(false)
  isActive   Boolean        @default(true)
  employees  EmployeePost[]
  shifts     Shift[]
  staffingNeeds StaffingNeed[]
  sites      SitePost[]
}

// The posts a site uses on its planning and in its staffing needs. A site
// without any line here uses every active post.
model SitePost {
  siteId String
  site   Site   @relation(fields: [siteId], references: [id])
  postId String
  post   Post   @relation(fields: [postId], references: [id])

  @@id([siteId, postId])
}

// ───────────── People ─────────────
// Only what planning and the time clock need. Salary and HR documents arrive
// with the HR brick.

model Employee {
  id          String           @id @default(uuid())
  payfitId    String?          @unique // filled once the PayFit sync exists
  skelloId    String?          @unique // set by the Skello import, to run it again safely
  firstName   String
  lastName    String
  phone       String? // shown to colleagues only as the contact of a service
  pinHash     String? // PIN for the tablet, never stored in clear
  isActive    Boolean          @default(true)
  user        User?
  contracts   Contract[]
  assignments SiteAssignment[]
  posts       EmployeePost[]
  shifts      Shift[]
  clockEvents ClockEvent[]
  absences    Absence[]
  timeEntries TimeEntry[]
  leaveRequests LeaveRequest[]
  archiveRequests ArchiveRequest[]
}

enum ContractType {
  CDI
  CDD
  EXTRA
  APPRENTICE
  INTERN // "Stage" in Skello
  TEMPORARY // "Temporaire" in Skello: agency staff
}

model Contract {
  id            String       @id @default(uuid())
  employeeId    String
  employee      Employee     @relation(fields: [employeeId], references: [id])
  legalEntityId String
  legalEntity   LegalEntity  @relation(fields: [legalEntityId], references: [id])
  type          ContractType
  weeklyHours   Decimal?     @db.Decimal(5, 2) // 39, 35, 25… null for forfait jours
  forfaitJours  Boolean      @default(false) // forfait jours staff do not clock
  startDate     DateTime     @db.Date
  endDate       DateTime?    @db.Date
}

model SiteAssignment {
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  siteId     String
  site       Site     @relation(fields: [siteId], references: [id])
  isPrimary  Boolean  @default(false)
  // Row of the person in this site's planning; null = after the others.
  planningOrder Int?

  @@id([employeeId, siteId])
}

model EmployeePost {
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  postId     String
  post       Post     @relation(fields: [postId], references: [id])

  @@id([employeeId, postId])
}

// ───────────── Accounts and rights ─────────────

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  // True while the password is the temporary one given by an administrator.
  mustChangePassword Boolean @default(false)
  isActive     Boolean     @default(true)
  employeeId   String?     @unique
  employee     Employee?   @relation(fields: [employeeId], references: [id])
  roleGrants   RoleGrant[]
  passwordTokens PasswordToken[]
  notifications  Notification[]
  createdAt    DateTime    @default(now())
}

// A one-time link sent by e-mail to choose a password: an invitation for a
// new account, or a reset. Only the hash of the token is stored.
enum PasswordTokenPurpose {
  INVITE
  RESET
}

model PasswordToken {
  id        String               @id @default(uuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id])
  tokenHash String               @unique
  purpose   PasswordTokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime             @default(now())

  @@index([userId])
}

enum Role {
  HEAD_CHEF
  MANAGER
  SITE_DIRECTOR
  MULTI_SITE_MANAGER
  HR
  OPS // office operations team: sees every site, changes nothing
  ADMIN
}

// "This user has this role on this site." A null site means all sites.
// Every user linked to an employee is also an employee, without a grant.
model RoleGrant {
  id     String  @id @default(uuid())
  userId String
  user   User    @relation(fields: [userId], references: [id])
  role   Role
  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id])

  @@unique([userId, role, siteId])
}

// A tablet registered for one site. Only the hash of its token is stored.
model Device {
  id          String       @id @default(uuid())
  name        String
  siteId      String
  site        Site         @relation(fields: [siteId], references: [id])
  tokenHash   String       @unique
  createdAt   DateTime     @default(now())
  revokedAt   DateTime?
  clockEvents ClockEvent[]
}

// ───────────── Planning ─────────────

enum Service {
  AM
  PM
}

model Shift {
  id          String   @id @default(uuid())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id])
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  postId      String
  post        Post     @relation(fields: [postId], references: [id])
  service     Service
  startsAt    DateTime
  endsAt      DateTime
  breakMinutes Int     @default(20)
  meals       Int      @default(1) // meals taken during the shift
  note        String?
  createdById String
  createdAt   DateTime @default(now())

  @@index([siteId, startsAt])
  @@index([employeeId, startsAt])
}

// What a restaurant needs as a general rule, the same every week: for a day
// of the week and a service, how many people on a post, or how many in
// total in a department ("at least 5 on the floor on Saturday night").
model StaffingNeed {
  id         String      @id @default(uuid())
  siteId     String
  site       Site        @relation(fields: [siteId], references: [id])
  weekday    Int // 0 = Monday … 6 = Sunday
  service    Service
  postId     String? // a post…
  post       Post?       @relation(fields: [postId], references: [id])
  department Department? // …or the whole department, when postId is empty
  count      Int

  @@index([siteId])
}

// One department (kitchen or salle) of one week of a site, made visible to
// the staff. The head chef publishes the kitchen; the site director either.
// Until then only people with a role see those shifts.
model Publication {
  siteId        String
  site          Site       @relation(fields: [siteId], references: [id])
  weekStart     DateTime   @db.Date // the Monday
  department    Department
  publishedById String
  publishedAt   DateTime   @default(now())

  @@id([siteId, weekStart, department])
}

// The lock shown next to each day of the planning. No row = open (grey).
enum DayLockStatus {
  LOCKED // blue: the day can no longer be edited
  PAYROLL // red: the day is being counted for payslips
}

model DayLock {
  siteId  String
  site    Site          @relation(fields: [siteId], references: [id])
  date    DateTime      @db.Date
  status  DayLockStatus
  setById String
  setAt   DateTime      @default(now())

  @@id([siteId, date])
}

// ───────────── Absences ─────────────

enum AbsenceCategory {
  EMPLOYER_PAID
  THIRD_PARTY_PAID
  UNPAID
  NEUTRAL
}

// The catalogue transcribed from Skello: docs/reference/absence-types.md.
model AbsenceType {
  id                    String          @id @default(uuid())
  name                  String          @unique
  category              AbsenceCategory
  isActive              Boolean
  earnsLeave            Boolean
  compensatoryIndemnity Boolean
  employeeCanRequest    Boolean
  overtimeMajorees      Boolean? // null for categories without this setting
  blocksPlanning        Boolean         @default(false) // true for arrêt maladie
  // A day of it adds a fifth of the contract to the weekly counter.
  // True for congé payé and récupération JF.
  countsInCounter       Boolean         @default(false)
  absences              Absence[]
  leaveRequests         LeaveRequest[]
}

enum DayPart {
  FULL_DAY
  HALF_DAY
  CUSTOM // startTime and endTime are filled
}

// An absence covers whole dates, from startDate to endDate included.
model Absence {
  id            String      @id @default(uuid())
  employeeId    String
  employee      Employee    @relation(fields: [employeeId], references: [id])
  absenceTypeId String
  type          AbsenceType @relation(fields: [absenceTypeId], references: [id])
  startDate     DateTime    @db.Date
  endDate       DateTime    @db.Date
  dayPart       DayPart     @default(FULL_DAY)
  startTime     String? // "HH:MM", only for CUSTOM
  endTime       String?
  note          String?
  createdById   String
  createdAt     DateTime    @default(now())

  @@index([employeeId, startDate])
}

// ───────────── Leave requests ─────────────

enum LeaveStatus {
  PENDING
  APPROVED
  REFUSED
  CANCELLED // withdrawn by the employee before a decision
}

// Who takes the final decision. Worked out when the request is made
// (src/leave/leave.rules.ts) and stored, so it can always be explained.
enum LeaveRoute {
  DIRECTOR // the site director: salle staff, and the head chef's own request
  CHEF // the head chef: kitchen staff
  MULTI_SITE // the multi-site manager, for a site director's own request
  OPS // the operations team, for a multi-site manager's own request
  HR // the operations team's own requests, office and lab staff
}

model LeaveRequest {
  id             String      @id @default(uuid())
  employeeId     String
  employee       Employee    @relation(fields: [employeeId], references: [id])
  siteId         String // the employee's main site when the request was made
  site           Site        @relation(fields: [siteId], references: [id])
  absenceTypeId  String
  type           AbsenceType @relation(fields: [absenceTypeId], references: [id])
  startDate      DateTime    @db.Date
  endDate        DateTime    @db.Date
  dayPart        DayPart     @default(FULL_DAY)
  startTime      String?
  endTime        String?
  note           String?
  route          LeaveRoute
  status         LeaveStatus @default(PENDING)
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?
  absenceId      String?     @unique // the absence created on approval
  createdAt      DateTime    @default(now())

  @@index([siteId, status])
  @@index([employeeId, startDate])
}

// ───────────── Time clock ─────────────

enum ClockKind {
  IN
  OUT
  BREAK_START
  BREAK_END
}

// Raw clockings. Append-only: a database trigger refuses any update or delete
// (see the first migration). Corrections will be separate records.
// The id is generated by the tablet, so an event sent twice is stored once.
model ClockEvent {
  id         String    @id
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  siteId     String
  site       Site      @relation(fields: [siteId], references: [id])
  deviceId   String
  device     Device    @relation(fields: [deviceId], references: [id])
  kind       ClockKind
  occurredAt DateTime // time on the tablet when the employee clocked
  receivedAt DateTime  @default(now()) // time the server got it

  @@index([employeeId, occurredAt])
  @@index([siteId, occurredAt])
}

// What the manager validated for one stretch of work: the hours that will go
// to payroll. Created when a clocking is validated or corrected, or when hours
// are added by hand for someone who did not clock. The raw ClockEvents are
// never touched; every change here is also written to the audit log.
model TimeEntry {
  id            String    @id @default(uuid())
  siteId        String
  site          Site      @relation(fields: [siteId], references: [id])
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id])
  shiftId       String? // the planned shift it was compared with, if any
  clockInAt     DateTime? // the clock-in it validates; null = added by hand
  date          DateTime  @db.Date // day at the site
  startsAt      DateTime
  endsAt        DateTime
  breakMinutes  Int
  workedMinutes Int
  meals         Int       @default(0)
  corrected     Boolean   @default(false) // true when the manager changed the computed hours
  absent        Boolean   @default(false) // "Abs.": did not come; nothing is paid
  absenceId     String? // the absence this "Abs." put on the planning
  reason        String?
  validatedById String
  validatedAt   DateTime  @default(now())

  @@unique([employeeId, clockInAt])
  @@index([siteId, date])
}

// ───────────── Notifications ─────────────

// A message for one account, read inside the application (the bell).
model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  title     String
  body      String
  link      String // where clicking it leads, inside the app
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([userId, createdAt])
}

// ───────────── Audit ─────────────

model AuditLog {
  id            String   @id @default(uuid())
  at            DateTime @default(now())
  actorUserId   String?
  actorDeviceId String?
  action        String // e.g. "shift.create"
  entity        String
  entityId      String
  data          Json?

  @@index([entity, entityId])
}

// ───────────── Archiving an employee ─────────────

enum ArchiveStatus {
  PENDING
  APPROVED
  REFUSED
  CANCELLED
}

// A site director asks HR to archive someone. While the request waits, the
// person no longer shows on that site's planning; approved, the employee
// record is archived (isActive = false); refused or cancelled, they are back.
model ArchiveRequest {
  id            String        @id @default(uuid())
  employeeId    String
  employee      Employee      @relation(fields: [employeeId], references: [id])
  siteId        String
  site          Site          @relation(fields: [siteId], references: [id])
  reason        String?
  status        ArchiveStatus @default(PENDING)
  requestedById String
  requestedAt   DateTime      @default(now())
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?

  @@index([siteId, status])
  @@index([status])
}
