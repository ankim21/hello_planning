# Copy to .env and adjust. Never commit .env.
DATABASE_URL="postgresql://skellobis:skellobis@localhost:5433/skellobis"
PORT=3000
# Long random string; signs the login cookie. Generate with: openssl rand -hex 32
JWT_SECRET="change-me"
# E-mail. Leave SMTP_URL empty to send nothing: the administrator is then
# shown a temporary password to pass on by hand.
# Development: smtp://localhost:1025 (the fake mailbox, http://localhost:8025)
# Production: smtp://USER:PASSWORD@HOST:587 from your e-mail provider
SMTP_URL="smtp://localhost:1025"
MAIL_FROM="PLANetBAO <no-reply@example.com>"
# Public address of the web app, used in the links sent by e-mail.
APP_URL="http://localhost:5173"

# First administrator, created by `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-too"
